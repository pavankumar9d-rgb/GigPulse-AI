# ==============================================================================
# GIGPULSE AI — ZERO-BUDGET ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend Environment (services/api)
# ------------------------------------------------------------------------------
# Port for FastAPI uvicorn runner (defaults to 8001 for local dev)
PORT=8001

# Local SQLite storage path (default)
GIGPULSE_DB_PATH=gigpulse.db

# Optional Cloud Database: PostgreSQL (e.g. Neon Free Tier / Supabase Free)
# Automatically converts legacy postgres:// to postgresql:// for SQLAlchemy 2.0+
# DATABASE_URL=postgresql://user:password@ep-cool-flower.ap-southeast-1.aws.neon.tech/gigpulse?sslmode=require

# Public Demo Mode: Restricts destructive mutations (imports commit, account delete, model retrain)
# Set to 'true' in public production web deployments; 'false' in local dev
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Environment (apps/web)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI backend API
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Map Tile Provider URL for 3D Spatial Globe (Defaults to OpenStreetMap zero-cost tiles)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Open-Meteo Free Weather API (No API key needed; CC BY 4.0 license)
# https://api.open-meteo.com/v1/forecast

